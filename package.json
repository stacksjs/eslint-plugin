{
  "name": "@stacksjs/eslint-plugin",
  "type": "module",
  "version": "0.2.4",
  "description": "The Stacks ESLint plugin",
  "license": "MIT",
  "funding": "https://github.com/sponsors/chrisbbreuer",
  "homepage": "https://github.com/stacksjs/eslint-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/stacksjs/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/unocss/unocss/issues"
  },
  "keywords": [
    "eslint-plugin",
    "eslint"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs"
    }
  },
  "module": "dist/index.mjs",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "unbuild",
    "typecheck": "tsc --noEmit",
    "lint": "bun run build && cd ./fixtures && bunx eslint ./src",
    "changelog": "bunx logsmith --verbose",
    "changelog:generate": "bunx logsmith --output CHANGELOG.md",
    "release": "bun run changelog:generate && bunx bumpx prompt --recursive",
    "postinstall": "bunx git-hooks",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@stacksjs/eslint-config": "^4.10.2-beta.3",
    "@typescript-eslint/utils": "^8.54.0",
    "@unocss/config": "66.6.0",
    "@unocss/core": "66.6.0",
    "magic-string": "^0.30.21",
    "synckit": "^0.11.12",
    "unocss": "^66.6.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.6.0",
    "@eslint/markdown": "^6.6.0",
    "@stacksjs/bumpx": "^0.2.4",
    "@stacksjs/gitlint": "^0.1.5",
    "@stacksjs/logsmith": "^0.2.1",
    "@stacksjs/path": "latest",
    "@stylistic/eslint-plugin": "^4.4.1",
    "@types/bun": "^1.3.8",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/eslint-plugin": "^1.6.6",
    "buddy-bot": "^0.9.12",
    "bun-git-hooks": "^0.3.1",
    "eslint-config-flat-gitignore": "^2.1.0",
    "eslint-flat-config-utils": "^2.1.4",
    "eslint-merge-processors": "^2.0.0",
    "eslint-plugin-antfu": "^3.2.0",
    "eslint-plugin-command": "^3.4.0",
    "eslint-plugin-format": "^1.4.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-jsonc": "^2.21.0",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-regexp": "^2.10.0",
    "eslint-plugin-toml": "^0.13.1",
    "eslint-plugin-unicorn": "^59.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "eslint-plugin-vue": "^10.7.0",
    "eslint-plugin-yml": "^1.19.1",
    "eslint-processor-vue-blocks": "^2.0.0",
    "eslint-vitest-rule-tester": "^2.3.0",
    "unbuild": "3.6.1",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0"
  },
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bunx --bun eslint --fix"
      }
    },
    "commit-msg": "bunx gitlint --edit .git/COMMIT_EDITMSG"
  }
}
